/* EV-Traction Lab — flat theme. @role tokens are replaced by gui/theme.py from one palette. */

* {
    font-family: @font;
    font-size: 10pt;
}

QMainWindow, QDialog, QWidget#central {
    background: @bg;
}

QWidget {
    color: @text;
}

QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

QToolTip {
    background: @card;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 6px;
}

/* --- menus and status bar ---------------------------------------------------------- */

QMenuBar {
    background: @bg;
    color: @text;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: @selection;
    color: @text;
}

QMenu {
    background: @card;
    color: @text;
    border: 1px solid @border;
    padding: 4px;
}

QMenu::item {
    padding: 4px 18px;
    border-radius: 4px;
}

QStatusBar {
    background: @bg;
    color: @muted;
    border-top: 1px solid @border;
}

/* --- tabs as rounded pills --------------------------------------------------------- */

QTabWidget::pane {
    border: none;
    background: @bg;
    top: 4px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: @tab;
    color: @text;
    border: 1px solid @tab;
    border-radius: 13px;
    padding: 5px 14px;
    margin: 4px 3px 2px 3px;
}

QTabBar::tab:hover:!selected {
    background: @selection;
}

QTabBar::tab:selected {
    border: 1px solid @primary;
    background: @primary;
    color: @on_primary;
    font-weight: bold;
}

/* --- cards, group boxes, KPI tiles ---------------------------------------------------- */

QFrame#card, QFrame#kpi {
    background: @card;
    border: 1px solid @border;
    border-radius: 8px;
}

QLabel#cardTitle {
    font-weight: bold;
    font-size: 10.5pt;
}

QLabel#kpiLabel {
    color: @muted;
    font-size: 9pt;
}

QLabel#kpiValue {
    color: @text;
    font-size: 19pt;
    font-weight: bold;
}

QGroupBox {
    background: @card;
    border: 1px solid @border;
    border-radius: 8px;
    margin-top: 12px;
    padding: 6px 4px 4px 4px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    padding: 0 4px;
    color: @text;
}

QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton {
    font-weight: normal;
}

/* --- buttons ------------------------------------------------------------------------ */

QPushButton {
    background: @card;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 8px;
}

QPushButton:hover {
    background: @hover;
}

QPushButton:pressed, QPushButton:checked {
    background: @selection;
}

QPushButton:disabled {
    color: @muted;
    background: @bg;
}

QPushButton[role="primary"] {
    background: @primary;
    color: @on_primary;
    border: none;
    font-weight: bold;
    min-height: 26px;
}

QPushButton[role="primary"]:hover {
    background: @primary_hover;
}

QPushButton[role="primary"]:pressed {
    background: @primary_pressed;
}

QPushButton[role="primary"]:disabled {
    background: @primary_disabled;
    color: @on_primary;
}

/* --- inputs with a focus ring --------------------------------------------------------- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: @input;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 2px 4px;
    selection-background-color: @selection;
    selection-color: @text;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid @primary;
    padding: 1px 3px;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: @muted;
    background: @bg;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: @card;
    color: @text;
    border: 1px solid @border;
    selection-background-color: @selection;
    selection-color: @text;
}

QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    width: 14px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QCheckBox::indicator {
    border: 1px solid @muted;
    border-radius: 4px;
    background: @input;
}

QCheckBox::indicator:checked {
    background: @primary;
    border: 1px solid @primary;
}

QRadioButton::indicator {
    border: 1px solid @muted;
    border-radius: 8px;
    background: @input;
}

QRadioButton::indicator:checked {
    background: @primary;
    border: 3px solid @input;
}

QSlider::groove:horizontal {
    height: 4px;
    background: @border;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: @primary;
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: @primary;
    border-radius: 2px;
}

QProgressBar {
    background: @tab;
    color: @text;
    border: none;
    border-radius: 6px;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background: @primary;
    border-radius: 6px;
}

/* --- tables ------------------------------------------------------------------------- */

QTableWidget, QTableView {
    background: @card;
    alternate-background-color: @bg;
    color: @text;
    gridline-color: @border;
    border: 1px solid @border;
    border-radius: 6px;
    selection-background-color: @selection;
    selection-color: @text;
}

QTableWidget#slotTable {
    font-size: 8.5pt;
}

QHeaderView::section {
    background: @tab;
    color: @text;
    border: none;
    border-right: 1px solid @border;
    border-bottom: 1px solid @border;
    padding: 4px 6px;
}

QTableCornerButton::section {
    background: @tab;
    border: none;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    width: 10px;
    height: 10px;
}

QScrollBar::handle {
    background: @border;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* --- text roles and chips ------------------------------------------------------------- */

QLabel[role="muted"] {
    color: @muted;
}

QLabel[role="hint"] {
    color: @muted;
    font-size: 9pt;
}

QLabel[role="success"] {
    color: @success;
}

QLabel[role="error"] {
    color: @alert_fg;
    font-weight: bold;
}

QLabel[role="note"] {
    color: @note;
}

QLabel[role="info"] {
    color: @info;
    font-weight: bold;
}

QLabel#kpiValue[role="error"] {
    color: @alert_fg;
}

QLabel[role="warning"] {
    background: @alert_bg;
    color: @alert_fg;
    border: 1px solid @alert_border;
    border-radius: 6px;
    padding: 4px 8px;
}

QLabel[chip="demo"] {
    background: @demo_bg;
    color: @demo_fg;
    border: 1px solid @demo_border;
    border-radius: 10px;
    padding: 2px 10px;
    font-weight: bold;
}

QLabel[chip="alert"] {
    background: @alert_bg;
    color: @alert_fg;
    border: 1px solid @alert_border;
    border-radius: 10px;
    padding: 2px 10px;
    font-weight: bold;
}

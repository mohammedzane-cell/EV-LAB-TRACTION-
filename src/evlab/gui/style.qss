/* EV-LAB · Electric Traction Research Studio — stylesheet of the design system (docs/ui_design_system.md).
   @role tokens are replaced by gui/theme.py from evlab/palette.py; @font, @display and @mono are the
   font stacks. Radii: 3 px chips, 4 px controls, 6 px panels. Lines: 1 px; accent marks: 2–3 px. */

* {
    font-family: @font;
    font-size: 10pt;
}

QMainWindow, QDialog, QWidget#central, QWidget#workspace {
    background: @bg;
}

QWidget {
    color: @text;
}

QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

QToolTip {
    background: @card;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 5px 8px;
}

/* --- application shell: menu, sidebar, header, status bar ------------------------------- */

QMenuBar {
    background: @surface;
    color: @muted;
    border-bottom: 1px solid @divider;
    padding: 1px 4px;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: @hover;
    color: @text;
}

QMenu {
    background: @card;
    color: @text;
    border: 1px solid @border;
    padding: 4px;
}

QMenu::item {
    padding: 5px 22px 5px 14px;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background: @divider;
    margin: 4px 6px;
}

QFrame#sidebar {
    background: @surface;
    border: none;
    border-right: 1px solid @divider;
}

QLabel#wordmark {
    font-family: @display;
    font-size: 15pt;
    font-weight: 600;
    color: @text;
}

QLabel#subtitle {
    color: @muted;
    font-size: 6.5pt;
    font-weight: 600;
}

QLabel#navGroup {
    color: @muted;
    font-size: 7.5pt;
    font-weight: 600;
    padding: 10px 0px 2px 12px;
}

QToolButton#navItem {
    background: transparent;
    color: @muted;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0px;
    padding: 6px 8px 6px 10px;
    text-align: left;
    font-size: 9.5pt;
}

QToolButton#navItem:hover {
    background: @hover;
    color: @text;
}

QToolButton#navItem:checked {
    background: @accent_soft;
    color: @text;
    border-left: 2px solid @primary;
    font-weight: 600;
}

QToolButton#navItem:focus, QToolButton#navHelp:focus, QToolButton#headerAction:focus,
QToolButton#collapse:focus {
    outline: none;
    border: 1px solid @primary;
}

QToolButton#navHelp {
    background: transparent;
    color: @muted;
    border: 1px solid transparent;
    border-radius: 4px;
    font-weight: 600;
    font-size: 8.5pt;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0px;
}

QToolButton#navHelp:hover {
    color: @primary;
    border: 1px solid @border;
}

QToolButton#collapse {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolButton#collapse:hover {
    background: @hover;
}

QLabel#chainNote {
    color: @muted;
    font-size: 8pt;
    padding: 0px 12px;
}

QFrame#header {
    background: @surface;
    border: none;
    border-bottom: 1px solid @divider;
}

QLabel#wsIndex {
    font-family: @mono;
    color: @primary;
    font-size: 10pt;
    font-weight: 600;
}

QLabel#wsTitle {
    font-family: @display;
    font-size: 15pt;
    font-weight: 600;
    color: @text;
}

QLabel#wsCaption {
    color: @muted;
    font-size: 9pt;
}

QLabel#motorContext {
    background: @card;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 9pt;
}

QToolButton#headerAction {
    background: transparent;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 9pt;
}

QToolButton#headerAction:hover {
    background: @hover;
    border: 1px solid @primary;
}

QStatusBar {
    background: @surface;
    color: @muted;
    border-top: 1px solid @divider;
}

QStatusBar QLabel {
    color: @muted;
    font-size: 8.5pt;
}

/* --- inner tab bars (the workspace tab bar itself is hidden: the sidebar navigates) ------ */

QTabWidget::pane {
    border: none;
    background: @bg;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: @muted;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px;
    margin: 0px 2px;
}

QTabBar::tab:hover:!selected {
    color: @text;
}

QTabBar::tab:selected {
    color: @text;
    border-bottom: 2px solid @primary;
    font-weight: 600;
}

/* --- result panels, input sections, readouts -------------------------------------------- */

QFrame#card {
    background: @card;
    border: 1px solid @border;
    border-radius: 6px;
}

QLabel#cardTitle {
    font-weight: 600;
    font-size: 10.5pt;
    color: @text;
}

QLabel#sectionHeader {
    color: @muted;
    font-size: 8pt;
    font-weight: 600;
    padding: 0px;
}

QFrame#divider {
    background: @divider;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#kpi {
    background: @card;
    border: 1px solid @border;
    border-left: 3px solid @primary;
    border-radius: 4px;
}

QLabel#kpiLabel {
    color: @muted;
    font-size: 8.5pt;
}

QLabel#kpiValue {
    color: @text;
    font-family: @display;
    font-size: 17pt;
    font-weight: 600;
}

/* input sections of the left panel: a quiet surface, the title marked by the accent */
QGroupBox {
    background: @card;
    border: 1px solid @divider;
    border-radius: 6px;
    margin-top: 13px;
    padding: 6px 4px 4px 4px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    padding: 0px 6px;
    color: @text;
    border-left: 2px solid @primary;
}

QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton {
    font-weight: normal;
}

/* --- buttons ------------------------------------------------------------------------ */

QPushButton {
    background: @tab;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 18px;
}

QPushButton:hover {
    background: @hover;
    border: 1px solid @muted;
}

QPushButton:focus {
    border: 1px solid @primary;
}

QPushButton:pressed, QPushButton:checked {
    background: @selection;
}

QPushButton:disabled {
    color: @disabled_text;
    background: @disabled_bg;
    border: 1px solid @disabled_bg;
}

QPushButton[role="primary"] {
    background: @primary;
    color: @on_primary;
    border: 1px solid @primary;
    font-weight: 600;
    min-height: 26px;
}

QPushButton[role="primary"]:hover {
    background: @primary_hover;
    border: 1px solid @primary_hover;
}

QPushButton[role="primary"]:focus {
    border: 1px solid @text;
}

QPushButton[role="primary"]:pressed {
    background: @primary_pressed;
}

QPushButton[role="primary"]:disabled {
    background: @primary_disabled;
    border: 1px solid @primary_disabled;
    color: @on_primary;
}

QPushButton[role="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: @primary;
}

QPushButton[role="ghost"]:hover {
    border: 1px solid @border;
}

/* --- inputs: value right-aligned, unit as suffix, focus ring in the accent ------------------- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: @input;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 2px 4px;
    min-height: 18px;
    selection-background-color: @selection;
    selection-color: @text;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border: 1px solid @muted;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid @primary;
    padding: 1px 3px;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: @disabled_text;
    background: @disabled_bg;
    border: 1px solid @disabled_bg;
}

QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled {
    color: @disabled_text;
}

QComboBox {
    padding-right: 22px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(@icons/down.svg);
    width: 10px;
    height: 6px;
}

QComboBox::down-arrow:disabled {
    image: url(@icons/down_off.svg);
}

QComboBox QAbstractItemView {
    background: @card;
    color: @text;
    border: 1px solid @border;
    selection-background-color: @selection;
    selection-color: @text;
    outline: none;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 18px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border: none;
    width: 16px;
    margin-top: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: none;
    width: 16px;
    margin-bottom: 2px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@icons/up.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@icons/down.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off {
    image: url(@icons/up_off.svg);
}

QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    image: url(@icons/down_off.svg);
}

QCheckBox, QRadioButton {
    spacing: 7px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QCheckBox::indicator {
    border: 1px solid @muted;
    border-radius: 3px;
    background: @input;
}

QCheckBox::indicator:checked {
    background: @primary;
    border: 1px solid @primary;
    image: url(@icons/check.svg);
}

QCheckBox::indicator:disabled {
    border: 1px solid @disabled_text;
    background: @disabled_bg;
}

QCheckBox:focus, QRadioButton:focus {
    color: @primary;
}

QRadioButton::indicator {
    border: 1px solid @muted;
    border-radius: 8px;
    background: @input;
}

QRadioButton::indicator:checked {
    background: @primary;
    border: 3px solid @input;
}

QRadioButton::indicator:disabled {
    border: 1px solid @disabled_text;
}

QRadioButton::indicator:checked:disabled {
    background: @disabled_text;
    border: 3px solid @disabled_bg;
}

QSlider::groove:horizontal {
    height: 3px;
    background: @border;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: @primary;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::sub-page:horizontal {
    background: @primary;
    border-radius: 1px;
}

QProgressBar {
    background: @tab;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    text-align: center;
    min-height: 18px;
    font-size: 8.5pt;
}

QProgressBar::chunk {
    background: @accent_soft;
    border-right: 2px solid @primary;
    border-radius: 3px;
}

QProgressBar#lossBar {
    background: @tab;
    border: none;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#lossBar::chunk {
    background: @muted;
    border: none;
    border-radius: 2px;
}

/* --- tables and trees: quiet rules, headers in the secondary surface ------------------------ */

QTableWidget, QTableView {
    background: @card;
    alternate-background-color: @bg;
    color: @text;
    gridline-color: @divider;
    border: 1px solid @border;
    border-radius: 4px;
    selection-background-color: @selection;
    selection-color: @text;
}

QTableWidget#slotTable {
    font-size: 8pt;
}

QTableWidget#slotTable QHeaderView::section {
    padding: 2px 0px;
    font-size: 7.5pt;
}

QHeaderView::section {
    background: @tab;
    color: @muted;
    border: none;
    border-right: 1px solid @divider;
    border-bottom: 1px solid @border;
    padding: 4px 6px;
    font-size: 8.5pt;
    font-weight: 600;
}

QTableCornerButton::section {
    background: @tab;
    border: none;
}

QTreeView {
    background: @card;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    selection-background-color: @selection;
    selection-color: @text;
    outline: none;
}

QTreeView::item {
    padding: 3px 0px;
}

QTreeView::item:hover:!selected {
    background: @hover;
}

QTreeView::item:selected {
    background: @selection;
    color: @text;
}

/* --- panels that scroll ----------------------------------------------------------------- */

QScrollArea#leftPanel, QWidget#leftContent {
    background: transparent;
    border: none;
}

QScrollArea#leftPanel > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    width: 8px;
    height: 8px;
}

QScrollBar::handle {
    background: @border;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: @muted;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: transparent;
}

/* --- plot legends (above the plot, never over the data) and readouts ---------------------- */

QLabel#plotLegend {
    color: @muted;
    font-size: 8.5pt;
}

QLabel#plotReadout {
    font-family: @mono;
    color: @text;
    background: @card;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 8pt;
}

/* --- text roles and provenance chips --------------------------------------------------- */

QLabel[role="muted"] {
    color: @muted;
}

QLabel[role="hint"] {
    color: @muted;
    font-size: 8.5pt;
}

QLabel[role="success"] {
    color: @success;
}

QLabel[role="error"] {
    color: @alert_fg;
    font-weight: 600;
}

QLabel[role="note"] {
    color: @note;
}

QLabel[role="info"] {
    color: @info;
    font-weight: 600;
}

QLabel#kpiValue[role="error"] {
    color: @alert_fg;
}

QLabel[role="warning"] {
    background: @alert_bg;
    color: @alert_fg;
    border: 1px solid @alert_border;
    border-left: 3px solid @alert_border;
    border-radius: 4px;
    padding: 5px 9px;
}

QLabel[chip="demo"] {
    background: @demo_bg;
    color: @demo_fg;
    border: 1px solid @demo_border;
    border-radius: 3px;
    padding: 1px 8px;
    font-size: 8.5pt;
    font-weight: 600;
}

QLabel[chip="alert"] {
    background: @alert_bg;
    color: @alert_fg;
    border: 1px solid @alert_border;
    border-radius: 3px;
    padding: 1px 8px;
    font-size: 8.5pt;
    font-weight: 600;
}

QLabel[chip="source"] {
    background: @tab;
    color: @muted;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 1px 8px;
    font-size: 8.5pt;
    font-weight: 600;
}

QLabel#emptyState {
    color: @muted;
    background: @card;
    border: 1px dashed @border;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 9pt;
}
